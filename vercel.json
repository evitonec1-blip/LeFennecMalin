{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.lefennecmalin.ch/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "lefennecmalin.ch" }]
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "public/**"
    },
    "api/docs.ts": {
      "memory": 128
    },
    "api/markdown.ts": {
      "memory": 128
    }
  },
  "headers": [
    {
      "source": "/premiums_2026.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/npa_to_region.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/api/markdown(.*)",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/docs",
      "destination": "/api/docs.ts"
    },
    {
      "source": "/api/markdown(.*)",
      "destination": "/api/markdown.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
